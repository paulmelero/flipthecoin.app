{
  "name": "@flipthecoin/app",
  "description": "The Online Coin Flip App",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "prepare": "nuxt prepare",
    "cf:preview": "npx wrangler --cwd ./ dev",
    "cf:logs": "pnpx wrangler pages deployment tail",
    "comments:clear-local": "wrangler d1 execute flipthecoin-comments --local --command \"PRAGMA defer_foreign_keys=ON; DELETE FROM comments;\"",
