    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.0.15",
    "@types/three": "^0.156.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.8",
    "daisyui": "^4.12.23",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "kysely": "^0.29.6",
    "nitro-cloudflare-dev": "^0.2.1",
    "nuxt": "4.4.2",
